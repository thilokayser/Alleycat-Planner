# Vom install.php-Installer erzeugt — enthält DB-Zugangsdaten + API-Key im Klartext.
php-backend/config.php

# Von install.php automatisch erzeugte Pretty-URL-Konfiguration fürs Web-
# Root eines echten Deployments (siehe CLAUDE.md) — kein Repo-Inhalt.
# Ausschließlich im Repo-Root ignoriert, nicht rekursiv: php-backend/.htaccess
# ist ein bewusst versionierter Schutz für config.php und bleibt getrackt.
/.htaccess

# Export der Auto-Backup-Funktion (data-safety.js/storage-server.js/
# storage-local.js) — Werkzeug-Ausgabe aus manuellem Testen, kein Repo-Inhalt.
alleycat-autobackup-*.json
alleycat-autobackup-*.sqlite

# macOS Finder
.DS_Store

# Build-Output — per `node build.js` aus src/ generiert, nicht versioniert.
dist/

# Referenz-Hash des lokalen Builds, gesetzt zu Beginn eines Arbeitspakets:
#   node build.js && shasum dist/alleycat-dispatch-local.html > .local-baseline
#   node build.js && shasum -c .local-baseline
# Schlägt an, wenn Server-Code in den geteilten Kern leckt. Arbeitsgerüst pro
# Arbeitskopie — der dauerhafte Schutz ist assertCoreIsBackendAgnostic() in
# build.js, siehe CLAUDE.md.
.local-baseline

# Lokaler Cache/Config von Claude Code
.impeccable/
.agents/
.claude/
skills-lock.json
